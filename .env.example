# Sao chép file này thành .env và điền giá trị thật (KHÔNG commit file .env)
PORT=3000

# Tài khoản CHỈ ĐỌC trên MongoDB Atlas (reader_23IT257)
MONGODB_URI_READ=mongodb+srv://reader_23IT257:<password>@<cluster>.mongodb.net/DB_23IT257?retryWrites=true&w=majority

# Tài khoản CHỈ GHI trên MongoDB Atlas (writer_23IT257)
MONGODB_URI_WRITE=mongodb+srv://writer_23IT257:<password>@<cluster>.mongodb.net/DB_23IT257?retryWrites=true&w=majority

# Chuỗi bí mật ký cookie session
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai
