{{#if flash}}<div class="alert {{flash.type}}">{{flash.message}}</div>{{/if}}

<section class="card">
  <h2>Thêm sách mới</h2>
  <form method="post" action="/books">
    <label>Mã sách (bắt đầu bằng {{student.prefix}})
      <input name="code" required placeholder="{{student.prefix}}001" value="{{form.code}}">
    </label>
    <label>Tên sách
      <input name="title" required value="{{form.title}}">
    </label>
    <label>Tác giả
      <input name="author" value="{{form.author}}">
    </label>
    <label>Giá gốc (VND)
      <input name="price" type="number" min="0" step="any" required value="{{form.price}}">
    </label>
    <button type="submit">Thêm (VAT {{student.vat}}%)</button>
  </form>
  <p><small>Số sách bạn đã thêm trong phiên này: <strong>{{addedCount}}</strong> (lưu trong session trên MongoDB Atlas)</small></p>
</section>

<section class="card">
  <h2>Danh sách sách</h2>
  {{#if books.length}}
  <table>
    <thead>
      <tr><th>Mã sách</th><th>Tên sách</th><th>Tác giả</th><th class="num">Giá gốc</th><th class="num">VAT</th><th class="num">Giá sau thuế</th></tr>
    </thead>
    <tbody>
      {{#each books}}
      <tr>
        <td>{{code}}</td>
        <td>{{title}}</td>
        <td>{{author}}</td>
        <td class="num">{{money price}}</td>
        <td class="num">{{vatPercent}}%</td>
        <td class="num">{{money priceAfterTax}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p>Chưa có sách nào.</p>
  {{/if}}
</section>
